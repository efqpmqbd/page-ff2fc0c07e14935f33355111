(max-width: 768px) {\n  .band-1 h1 {font-size: 2.25rem}\n  .band {padding: 3rem 1rem}\n}\n</style><header>\n  <div class=\"logo\">cnrocket</div>\n  <ul class=\"quick-links\">\n    <li><a href=\"#features\">核心特性</a></li>\n    <li><a href=\"#plans\">服务套餐</a></li>\n    <li><a href=\"#faq\">常见问题</a></li>\n  </ul>\n</header>\n\n<main>\n  \n  <section class=\"band band-1\">\n    <div class=\"container\">\n      <h1>cnrocket 网络传输与数据中转服务</h1>\n      <p>面向开发者与企业用户的稳定网络传输方案。提供多线路优化配置、清晰的计费结构与高效的数据中转支持。</p>\n      <div class=\"cta-buttons\">\n        <a href=\"#plans\" class=\"btn btn-primary\">查看套餐</a>\n        <a href=\"#faq\" class=\"btn btn-secondary\">了解详情</a>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"band band-2\">\n    <div class=\"container\">\n      <h2>服务规范与技术特性</h2>\n      <div class=\"grid-facts\">\n        <div class=\"ticket-card\">\n          <h3>多路负载均衡</h3>\n          <p>系统自动检测并分发流量至多条可用通道，降低单点故障风险，保障链路持续通畅。</p>\n        </div>\n        <div class=\"ticket-card\">\n          <h3>透明流量结算</h3>\n          <p>所有套餐流量额度按自然月度周期清算，实时面板显示消耗明细，无隐藏扣费条款。</p>\n        </div>\n        <div class=\"ticket-card\">\n          <h3>自定义路由规则</h3>\n          <p>支持根据目标地址类型分流，满足复杂网络环境下的精细化数据传输需求。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\" class=\"band band-3\">\n    <div class=\"container\">\n      <h2>服务套餐与价格</h2>\n      <div class=\"plans-stack\">\n        \n        <div class=\"plan-card\">\n          <div class=\"plan-header\">\n            <span class=\"plan-name\">基础版</span>\n            <span class=\"plan-price\">¥15/月</span>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <a href=\"#\" class=\"btn btn-primary\">选择基础版</a>\n        </div>\n\n        <div class=\"plan-card featured\">\n          <div class=\"plan-header\">\n            <span class=\"plan-name\">旗舰版 (推荐)</span>\n            <span class=\"plan-price\">¥35/月</span>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <a href=\"#\" class=\"btn btn-primary\">选择旗舰版</a>\n        </div>\n\n        <div class=\"plan-card\">\n          <div class=\"plan-header\">\n            <span class=\"plan-name\">团队版</span>\n            <span class=\"plan-price\">¥85/月</span>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <a href=\"#\" class=\"btn btn-primary\">选择团队版</a>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\" class=\"band band-4\">\n    <div class=\"container\">\n      <h2>常见问题解答</h2>\n      <div class=\"faq-list\">\n        \n        <details class=\"faq-item\">\n          <summary>购买后如何获取节点配置信息？</summary>\n          <div class=\"faq-content\">\n            登录用户中心后，系统会根据您购买的套餐自动生成对应的订阅链接。您可将其复制并导入至主流兼容客户端中完成配置同步。\n          </div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>流量额度是否可以结转至下个月？</summary>\n          <div class=\"faq-content\">\n            不可以。所有套餐内包含的流量额度均为按月重置型，未使用的流量将在每月的结算日清零，不累计到下一个计费周期。\n          </div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>支持哪些主流客户端软件？</summary>\n          <div class=\"faq-content\">\n            cnrocket 兼容当前主流的各类开源与商业客户端，包括但不限于 Clash 系列、Shadowrocket、Surge 以及 v2rayN 等。具体配置教程可在文档中心查阅。\n          </div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>如遇到连接中断应如何处理？</summary>\n          <div class=\"faq-content\">\n            首先请检查本地网络环境及订阅链接是否为最新状态。如确认客户端无误，可通过用户后台提交工单，技术支持团队将在 24 小时内存取日志并协助排查。\n          </div>\n        </details>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <p>© cnrocket. All rights reserved.</p>\n  <p>稳定可靠的网络传输与数据中转服务提供商</p>\n</footer>",
